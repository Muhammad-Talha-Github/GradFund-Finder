# Local Compose credentials. Replace these values for your own environment.
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_DATABASE=gradfund
MYSQL_USER=gradfund
MYSQL_PASSWORD=replace_with_local_app_password

# MySQL URL (must match MYSQL_DATABASE, MYSQL_USER, and MYSQL_PASSWORD).
DATABASE_URL=mysql://gradfund:replace_with_local_app_password@127.0.0.1:3307/gradfund

# Optional: Tavily free tier; manual or scheduled academic discovery.
TAVILY_API_KEY=
TAVILY_MAX_QUERIES_PER_RUN=12
TAVILY_QUERIES_PER_RUN=12
TAVILY_MAX_RESULTS_PER_QUERY=15
TAVILY_RETRIES=0

# Bounded Crawlee + Cheerio collection. Static HTML only; no browser runtime by default.
CRAWL_MAX_PAGES=200
CRAWL_ROOTS_PER_RUN=200
CRAWL_MAX_CONCURRENCY=2
CRAWL_RETRIES=1
CRAWL_DOMAIN_DELAY_MS=1000
CRAWL_DOMAIN_DELAY_SECONDS=1
CRAWL_LINKS_PER_PAGE=8
CRAWL_REFRESH_DAYS=7

# Optional Gemini extractor. Set provider to rules (default) or gemini. Keep keys server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EXTRACTION_PROVIDER=rules

# Optional AI email drafting (uses the same Gemini key regardless of EXTRACTION_PROVIDER).
# Configure a Google OAuth web client with this exact authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Generate with: openssl rand -base64 32
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional bounded Playwright recruitment scout. Browser install: npx playwright install chromium.
SCOUT_MAX_RESULTS=5
SCOUT_MAX_PAGES=20
SCOUT_MAX_CONCURRENCY=2
